<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.azathorpe.competitive-problem-receiver</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Competitive Problem Receiver</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://space.bilibili.com/204828664">BiliBili@翎肆忤鸠</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        A powerful IDEA plugin that acts as a bridge for competitive programmers. It listens for incoming problem data sent by the popular Competitive Companion browser extension and automatically parses it. Seamlessly fetch, view, and manage your programming contest problems directly within your IDE without leaving your workflow.
        <br/>
        一个强大的 IDEA 插件，作为算法竞赛选手的桥梁。它监听由流行的 Competitive Companion 浏览器扩展发送的题目数据并自动解析。无需离开工作流，即可在 IDE 中无缝获取、查看和管理你的编程竞赛题目
        <br/>
        Thanks for ur using! If you find any bugs or have any suggestions, please feel free to open an issue on the GitHub repository:
        <br/>
        感谢使用！如果您发现任何错误或有任何建议，请随时在 GitHub 仓库上打开一个 issue：
            https://github.com/Azathorpe/competitive-companion-onIDEA
        ]]>
    </description>

    <change-notes><![CDATA[
         Change notes displayed on the Plugin Page and IDE Plugin Manager when a new version of the plugin is released.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-change-notes
        <version>1.0.0</version>
        <changes>
            <change>Initial release of Competitive-companion-onIDEA plugin.</change>
            <change>Added support for fetching competitive programming problems directly into JetBrains IDEs.</change>
            <change>Implemented a tool window for displaying fetched problems and their details.</change>
            <change>Added settings configurable for customizing plugin behavior.</change>
            <change>Improved user interface for better user experience.</change>
        </changes>
        ]]>
    </change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!--    Setting    -->
        <applicationConfigurable
                parentId="tools"
                instance="com.azathorpe.cpr.settings.CCISettingsConfigurable"
                displayName="Competitive Problem Receiver"
                id="cpr.settings"/>

        <toolWindow factoryClass="com.azathorpe.cpr.window.WindowFactory" id="cpr" anchor="left" secondary="true"
                    icon="com.azathorpe.cpr.icons.CPRIcons.CCI_ICON"/>

        <postStartupActivity implementation="com.azathorpe.cpr.listener.StartUp"/>
    </extensions>
    
    <idea-version since-build="231.0"/>

    <applicationListeners>
        <listener class="com.azathorpe.cpr.listener.FileSwitchListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="cpr.editor.setCurrentLanguageTemplateAction" class="com.azathorpe.cpr.actions.editor.SetAsCurrentLanguageTemplate"
                text="Set Current Language Template" description="Set current language template">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="cpr.utils.switchListenPortAction" class="com.azathorpe.cpr.actions.editor.SwitchListenPortAction"
                text="Switch Port Listener Func">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="cpr.editor.GetSubmitFile" class="com.azathorpe.cpr.actions.editor.GetSubmitFile"
                text="Get Submit File" description="Get submit file of current problem">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

<!--        <group id="cpr.editor.menu" class="com.azathorpe.cpr.actions.editor.EditorMenuActionGroup" text="CCI Editor Menu"-->
<!--               popup="true" description="Description of the action">-->
<!--&lt;!&ndash;            <REF id="cpr.editor.group"/>&ndash;&gt;-->
<!--            <add-to-group group-id="EditorPopupMenu" anchor="first"/>-->
<!--        </group>-->
    </actions>
</idea-plugin>