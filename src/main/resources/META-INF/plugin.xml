<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.azathorpe.competitive-companion-onIDEA</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Competitive-companion-onIDEA</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description>
        A simple plugin to integrate Competitive Companion with JetBrains IDEs.
        It allows you to fetch competitive programming problems directly into your IDE for a seamless coding experience.

        Thank 4 ur use!
        If u find any bugs or have suggestions, feel free to open an issue on the GitHub repository:
            https://github.com/LuanHeMuYu
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!--    Setting    -->
        <applicationConfigurable
                parentId="tools"
                instance="com.azathorpe.cci.settings.CCISettingsConfigurable"
                displayName="Competitive Companion OnIDEA"
                id="cci.settings"/>

        <toolWindow factoryClass="com.azathorpe.cci.window.WindowFactory" id="cci" anchor="left" secondary="true"
                    icon="com.azathorpe.cci.icons.CCIIcons.CCI_ICON"/>
<!--        <applicationService serviceImplementation="com.azathorpe.cci.service.MyPluginInitService"/>-->
    </extensions>

    <applicationListeners>
        <listener class="com.azathorpe.cci.listener.FileSwitchListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="cci.editor.setCurrentLanguageTemplateAction" class="com.azathorpe.cci.actions.editor.SetCurrentLanguageTemplate"
                text="Set Current Language Template" description="Set current language template">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="cci.utils.switchListenPortAction" class="com.azathorpe.cci.actions.editor.SwitchListenPortAction"
                text="Switch Port Listener Func">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="cci.editor.GetSubmitFile" class="com.azathorpe.cci.actions.editor.GetSubmitFile"
                text="Get Submit File" description="Get submit file of current problem">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

<!--        <group id="cci.editor.menu" class="com.azathorpe.cci.actions.editor.EditorMenuActionGroup" text="CCI Editor Menu"-->
<!--               popup="true" description="Description of the action">-->
<!--&lt;!&ndash;            <REF id="cci.editor.group"/>&ndash;&gt;-->
<!--            <add-to-group group-id="EditorPopupMenu" anchor="first"/>-->
<!--        </group>-->
    </actions>
</idea-plugin>